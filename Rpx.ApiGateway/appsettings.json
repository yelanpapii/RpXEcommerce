{
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "monolithRoute": {
        "ClusterId": "modularMonolithCluster",
        "Match": {
          "Path": "/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "modularMonolithCluster": {
        "LoadBalancingPolicy": "RoundRobin",
        "Destinations": {
          "monolith": {
            "Address": "http://rpx-modular-monolith-host/"
          }
        }
      }
    }
  }
}
