{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Server=localhost;Port=5432;Database=modular_monolith;User Id=admin;Password=admin;",
    "RedisConnection": "redis:6379"
  },
  "Nats": {
    "Url": "nats://nats:4222",
    "Stream": "modular-monolith-events",
    "SubjectPrefix": "modular",
    "Entities": {
      "Orders": {
        "Created": {
          "Subject": "modular-order-created",
          "DurableConsumer": "modular-order-created"
        },
        "Updated": {
          "Subject": "modular-order-updated",
          "DurableConsumer": "modular-order-updated"
        },
        "Deleted": {
          "Subject": "modular-order-deleted",
          "DurableConsumer": "modular-order-deleted"
        }
      },
      "Stocks": {
        "Created": {
          "Subject": "modular.stock-initialization-requested",
          "DurableConsumer": "modular-stock-created"
        },
        "Updated": {
          "Subject": "modular-stock-updated",
          "DurableConsumer": "modular-stock-updated"
        },
        "Deleted": {
          "Subject": "modular-stock-deleted",
          "DurableConsumer": "modular-stock-deleted"
        }
      }
    }
  },
  "AuthConfiguration": {
    "Key": "your_secret_key_here_change_it_please",
    "Issuer": "DevTips",
    "Audience": "DevTips"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341",
          "apiKey": "abcde123"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "ShippingModularMonolith"
    }
  },
  "OTEL_EXPORTER_OTLP_ENDPOINT": "http://jaeger:4318",
  "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
  "OTEL_EXPORTER_OTLP_HEADERS": "X-Seq-ApiKey=abcde12345",
  "ProductCatalog": {
    "Colors": [
      {
        "Code": "BLC",
        "Name": "Black",
        "SortOrder": 1
      },
      {
        "Code": "BLN",
        "Name": "White",
        "SortOrder": 2
      },
      {
        "Code": "AZM",
        "Name": "Navy Blue",
        "SortOrder": 3
      },
      {
        "Code": "ROJ",
        "Name": "Red",
        "SortOrder": 4
      },
      {
        "Code": "GRS",
        "Name": "Gray",
        "SortOrder": 5
      },
      {
        "Code": "BLC",
        "Name": "Black",
        "SortOrder": 1
      },
      {
        "Code": "NEG",
        "Name": "Negro",
        "SortOrder": 1
      }
    ],
    "Sizes": [
      { "Code": "XS", "Name": "Extra Small", "SortOrder": 1 },
      { "Code": "S",  "Name": "Small", "SortOrder": 2 },
      { "Code": "M",  "Name": "Medium", "SortOrder": 3 },
      { "Code": "L",  "Name": "Large", "SortOrder": 4 },
      { "Code": "XL", "Name": "Extra Large", "SortOrder": 5 },
      { "Code": "XXL","Name": "Extra Extra Large", "SortOrder": 6 }
    ]
  }
}